#!/usr/bin/env python3
"""Run map capture, solve the board, and send the planned game clicks."""

from __future__ import annotations

import os
from pathlib import Path
import subprocess
import sys


ROOT = Path(__file__).resolve().parent
VENV_PYTHON = ROOT / ".venv" / "bin" / "python"
WINDOW_SOURCE = ROOT / "scripts" / "game_window.swift"
WINDOW_HELPER = ROOT / "scripts" / "game_window"


def main() -> None:
    if not VENV_PYTHON.is_file():
        raise SystemExit("项目虚拟环境不存在，请先按 README.md 中的步骤创建环境并安装依赖。")
    if Path(sys.prefix).resolve() != VENV_PYTHON.parent.parent.resolve():
        os.execv(str(VENV_PYTHON), [str(VENV_PYTHON), str(__file__), *sys.argv[1:]])

    if not WINDOW_HELPER.is_file() or WINDOW_SOURCE.stat().st_mtime > WINDOW_HELPER.stat().st_mtime:
        subprocess.run(
            ["swiftc", str(WINDOW_SOURCE), "-o", str(WINDOW_HELPER)],
            cwd=ROOT,
            check=True,
        )

    arguments = sys.argv[1:]
    script = "world_navigation.py" if "--navigate" in arguments else "play_game.py"
    if "--execute" not in arguments and "--dry-run" not in arguments:
        arguments.append("--execute")
    try:
        subprocess.run(
            [str(VENV_PYTHON), str(ROOT / "scripts" / script), *arguments],
            cwd=ROOT,
            check=True,
        )
    except subprocess.CalledProcessError as exc:
        raise SystemExit(exc.returncode) from None


if __name__ == "__main__":
    main()
